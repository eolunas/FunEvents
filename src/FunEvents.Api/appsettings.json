{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=funevents;Username=funevents;Password=funevents"
  },

  "ReservationPolicy": {
    "MaxTicketsPerRequest": 10,
    "MaxTicketsPerUserPerEvent": 10,
    "HoldWindow": "00:15:00",
    "IdempotencyWaitTimeout": "00:00:02",
    "IdempotencyPollInterval": "00:00:00.100"
  },

  "ReservationExpiration": {
    "PollingInterval": "00:00:30",
    "BatchSize": 200
  },

  "Security": {
    "ApiKey": {
      "HeaderName": "X-Api-Key",
      "CacheDuration": "00:00:30"
    },
    "RateLimiting": {
      "Enabled": true,
      "Window": "00:01:00",
      "AnonymousPermitLimit": 300,
      "QueueLimit": 0
    }
  },

  "IdempotencyCleanup": {
    "Retention": "24:00:00",
    "PollingInterval": "01:00:00"
  },

  "AllowedHosts": "*"
}
